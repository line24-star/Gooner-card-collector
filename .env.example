# Copy to .env and edit. All vars are prefixed MCO_.
# Folder the app watches for images/videos (defaults to ./media)
# MCO_MEDIA_DIR=./media
# SQLite database location (defaults to ./data/app.db)
# MCO_DATABASE_URL=sqlite:///./data/app.db
MCO_SECRET_KEY=change-me

# Server log files in data/logs: one per day, deleted after this many days.
# MCO_LOG_TO_FILE=true
# MCO_LOG_DAYS=2
